#!/usr/bin/env bash
# sweep-repos: reclaim Rust build artifacts across a root (default ~/repos) by
# running cargo-sweep per repo, enumerating repo-root Cargo.toml files instead
# of `cargo sweep -r <root>` -- which stalls walking into target/ and any large
# non-Rust subtrees. `find -maxdepth 3` reads only <root>/<org>/<repo> dir
# listings and never descends into target/ (depth 4+), so it is fast.
#
# Four modes:
#   manual    sweep-repos [--time DAYS]            one pass, remove artifacts
#                                                  older than DAYS (default 14)
#   watermark sweep-repos --ensure-free GIB        free-space driven: only acts
#                                                  when free space on the
#                                                  target-disk filesystem (where
#                                                  relocate-targets puts each
#                                                  repo's target/, default the
#                                                  dedicated SSD -- NOT ~/repos'
#                                                  filesystem) is below GIB, then
#                                                  sweeps in escalating tiers
#                                                  (gentlest first) until the
#                                                  floor is restored, falling
#                                                  back to an unconditional
#                                                  per-repo cap if age-based
#                                                  sweeping alone isn't enough.
#   watch     sweep-repos --ensure-free GIB --watch SECS
#                                                  same as watermark mode, but
#                                                  loops forever, checking every
#                                                  SECS. This is the reactive
#                                                  mode: meant to run as a
#                                                  long-lived systemd --user
#                                                  service instead of a cron,
#                                                  so a sudden build spike gets
#                                                  caught within seconds
#                                                  instead of waiting for the
#                                                  next scheduled tick.
#   maxsize   sweep-repos --maxsize SIZE            unconditional one-shot pass,
#                                                  caps every repo's target/ at
#                                                  SIZE (e.g. 5GB) by trimming
#                                                  its oldest artifacts.
#
# ORPHAN PASS (2026-09-27, opt-in via SWEEP_ORPHANS=1): relocate-targets leaves
# a DEST/<rel>/target behind when a copy dies before it commits (SIGKILL, power
# loss), and a hand-made dir under DEST is just as invisible: every mode above
# enumerates forward from ROOT, so nothing ever lists DEST. The orphan pass
# does, and removes only a leaf `target` dir that no live link resolves to or
# into, whose owning repo is gone or points elsewhere, that no cargo build
# holds, and that relocate-targets is not copying into (the shared
# DEST/.relocate.lock). Parents go only via rmdir, so a dir holding a live
# target cannot be removed. It fails closed: a broken enumeration, an empty
# live set, or more than ORPHAN_MAX orphans at once deletes nothing and
# alerts. Runs before the ladder when below the floor, once per
# ORPHAN_INTERVAL in watch mode regardless, and before the cap in maxsize mode.
# Design: docs/design/2026-09-27-cargo-target-orphan-sweep.md.
#
# BUG FIXED 2026-07-04: watermark mode used to check free space on ROOT's
# filesystem (~/repos, which lives on /). relocate-targets moved every repo's
# target/ onto a dedicated SSD via symlink, so / always had plenty of room and
# the watermark never tripped -- it logged "nothing to do" every day while the
# SSD silently filled to 100%. Fixed by checking TARGET_DISK instead.
#
# BUG FIXED 2026-07-05: --time-based tiers (even the harshest, 1d) can't touch
# repos rebuilt daily -- measured 4.4GiB reclaimed vs. ~205GiB reclaimed by
# --maxsize across the same repos, because active repos keep refreshing
# mtimes on old artifacts through incremental builds. A separate weekly
# --maxsize cron used to paper over this, but that only ran once a week while
# hot repos (second-brain, marquee) regrew 70GiB+ in the gap. Folded --maxsize
# into watermark mode itself as the last-resort tier: if the age-based ladder
# doesn't restore the floor, cap every repo unconditionally before giving up.
# This is what makes watch mode a real reactive fix instead of a faster-ticking
# version of the same incomplete remediation.
#
# REACTIVE, NOT CALENDAR-DRIVEN (2026-07-05): a fixed cron schedule (daily,
# weekly) always has a gap where the disk can silently fill between ticks --
# that gap is what caused two separate 0-byte incidents in one day. `--watch`
# replaces the daily/weekly crons with one continuously-running check: cheap
# when healthy (a single `df` call), and reacts within one poll interval the
# moment free space actually drops, instead of waiting for the next scheduled
# run. Installed as the sweep-repos-watchdog systemd --user service.
#
# Managed by scottidler/dotfiles via manifest (link: HOME -> $HOME). Edit the
# repo copy, not the ~/bin symlink. The service is the `sweep-repos-watchdog`
# entry in manifest.yml's script: section.
set -euo pipefail

# cron runs with a minimal PATH (/usr/bin:/bin) that omits ~/.cargo/bin, so the
# `command -v cargo-sweep` check below would fail and the script would exit
# without sweeping -- the exact silent failure that let / fill to 96%. Put
# cargo's bin dir on PATH ourselves so this behaves identically under cron and
# an interactive login shell.
export PATH="${HOME}/.cargo/bin:${PATH}"

DAYS=14
ROOT="${HOME}/repos"
TARGET_DISK="/media/saidler/intel-480gb-ssd"
DEST=""                 # relocate-targets' DEST; default ${TARGET_DISK}/cargo-target
ENSURE_FREE=""
MAXSIZE=""
WATCH=""
DRY_RUN=()

# Orphan pass knobs. Env rather than flags so the unit file sets them.
SWEEP_ORPHANS="${SWEEP_ORPHANS:-0}"
ORPHAN_MAX="${ORPHAN_MAX:-5}"
ORPHAN_INTERVAL="${ORPHAN_INTERVAL:-86400}"

# Escalation ladder for watermark mode: gentlest (most days = fewest artifacts
# removed) first, harshest last. Only descend a tier if the floor isn't yet met.
TIERS=(14 7 3 1)

# Last-resort cap used inside watermark/watch mode once the age-based ladder
# above is exhausted and the floor still isn't restored -- age stops mattering
# at that point, every repo's target/ (even one rebuilt seconds ago) gets
# capped. Same value the old standalone weekly maxsize cron used.
FALLBACK_CAP="20GB"

# When 1, sweep_pass/sweep_maxsize_pass skip any repo whose target/ isn't
# actually relocated onto TARGET_DISK. Set ONLY for watermark/watch mode
# (below); manual `--time`/`--maxsize` invocations are an explicit request to
# clean everything under ROOT and keep their original, broader scope.
#
# BUG FIXED 2026-07-24: watermark mode swept EVERY repo under ROOT on every
# trip, including repos whose target/ was never relocated (still local, on
# ROOT's own filesystem). Sweeping those does nothing to restore TARGET_DISK's
# free space -- pure collateral risk for zero benefit. Observed: slack-cli
# (local target/) hit "No such file or directory" on
# target/.fingerprint/*/invoked.timestamp mid-build while TARGET_DISK was
# below floor and --watch was actively sweeping in the background, even
# though slack-cli's target/ had nothing to do with TARGET_DISK's pressure.
ONLY_RELOCATED=0

usage() {
  cat >&2 <<'EOF'
usage: sweep-repos [--time DAYS | --ensure-free GIB [--watch SECS] | --maxsize SIZE] [--root DIR] [--target-disk DIR] [--dest DIR] [--dry-run]
  --time DAYS        manual mode: remove build artifacts older than DAYS (default: 14)
  --ensure-free GIB  watermark mode: sweep only when free space on the
                     target-disk filesystem is below GIB, escalating
                     14d -> 7d -> 3d -> 1d, then an unconditional
                     ${FALLBACK_CAP} per-repo cap, until the floor is restored
                     (overrides --time)
  --watch SECS       with --ensure-free: don't exit after one check -- loop
                     forever, re-checking every SECS. Meant to run as a
                     long-lived service (see sweep-repos-watchdog.service)
                     instead of a cron, so a sudden build spike is caught
                     within one poll interval instead of the next scheduled tick.
  --maxsize SIZE     one-shot mode: unconditionally cap every repo's target/ at
                     SIZE (e.g. 5GB), trimming oldest artifacts (overrides
                     --time and --ensure-free)
  --root DIR         search root to enumerate repos under (default: ~/repos)
  --target-disk DIR  filesystem to check free space on -- must match where
                     relocate-targets sends target/ dirs
                     (default: /media/saidler/intel-480gb-ssd)
  --dest DIR         relocate-targets' DEST, scanned by the orphan pass
                     (default: <target-disk>/cargo-target)
  --dry-run          report only; delete nothing
Enumerates <root>/<org>/<repo>/Cargo.toml (and, for worktree-managed repos,
<root>/<org>/<repo>/<worktree>/Cargo.toml) and runs cargo-sweep per repo.

Orphan pass (watermark, watch and maxsize modes; env):
  SWEEP_ORPHANS=0|1    1 enables it (default: 0, logs "orphan pass disabled")
  ORPHAN_MAX=N         more than N orphans at once aborts the pass, deleting
                       nothing (default: 5)
  ORPHAN_INTERVAL=SECS watch mode also runs it this often above the floor
                       (default: 86400)
Removes DEST target dirs no live link owns. Needs the default --root: it
scans all of DEST, so a narrower root would shrink the live set only.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --time)        DAYS="$2"; shift 2 ;;
    --ensure-free) ENSURE_FREE="$2"; shift 2 ;;
    --maxsize)     MAXSIZE="$2"; shift 2 ;;
    --watch)       WATCH="$2"; shift 2 ;;
    --root)        ROOT="$2"; shift 2 ;;
    --target-disk) TARGET_DISK="$2"; shift 2 ;;
    --dest)        DEST="$2"; shift 2 ;;
    --dry-run)     DRY_RUN=(--dry-run); shift ;;
    -h|--help)     usage; exit 0 ;;
    *) echo "sweep-repos: unknown arg: $1" >&2; usage; exit 2 ;;
  esac
done

if [[ -n "${WATCH}" && -z "${ENSURE_FREE}" ]]; then
  echo "sweep-repos: --watch requires --ensure-free" >&2
  exit 2
fi
DEST="${DEST:-${TARGET_DISK}/cargo-target}"
[[ "${SWEEP_ORPHANS}" =~ ^[01]$ ]] || { echo "sweep-repos: SWEEP_ORPHANS must be 0 or 1, got: ${SWEEP_ORPHANS}" >&2; exit 2; }
# No leading zero: bash arithmetic reads 010 as octal, and 08 is an error that
# turns the breaker's `if` false and falls through to the rm.
[[ "${ORPHAN_MAX}" =~ ^(0|[1-9][0-9]*)$ ]] || { echo "sweep-repos: ORPHAN_MAX must be a whole number (no leading zero), got: ${ORPHAN_MAX}" >&2; exit 2; }
[[ "${ORPHAN_INTERVAL}" =~ ^(0|[1-9][0-9]*)$ ]] || { echo "sweep-repos: ORPHAN_INTERVAL must be whole seconds (no leading zero), got: ${ORPHAN_INTERVAL}" >&2; exit 2; }

# Best-effort desktop toast. Works from cron by pointing at the user's session
# bus (cron has no DBUS_SESSION_BUS_ADDRESS). Never fails the script.
toast() {
  command -v notify-send >/dev/null 2>&1 || return 0
  local urgency="$1"; shift
  DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}" \
    notify-send -a sweep-repos -u "${urgency}" "$@" >/dev/null 2>&1 || true
}

# A missing cargo-sweep is the exact silent failure that let / fill to 100%:
# the cron logged "not installed" to a file nobody reads and swept nothing.
# Complain loudly so it can't rot unnoticed.
if ! command -v cargo-sweep >/dev/null 2>&1; then
  echo "sweep-repos: cargo-sweep not installed" >&2
  toast critical "sweep-repos: cargo-sweep MISSING" "Rust build artifacts are NOT being swept and the disk will fill. Install it: cargo install cargo-sweep"
  exit 1
fi

# The watchdog keeps the copy it started with in memory until restarted, so the
# journal has to say which revision is running. -dirty covers this file only:
# the dotfiles tree is rarely clean as a whole.
self="$(readlink -f "$0")"
if rev="$(git -C "$(dirname "${self}")" rev-parse --short HEAD 2>/dev/null)"; then
  git -C "$(dirname "${self}")" diff --quiet HEAD -- "${self}" 2>/dev/null || rev="${rev}-dirty"
else
  rev="unknown"
fi
echo "sweep-repos: revision ${rev} (${self})" >&2

# Available GiB on TARGET_DISK -- where relocate-targets actually puts each
# repo's target/ dir. This is deliberately NOT ROOT's filesystem: ROOT (~/repos)
# stays roomy forever once targets are relocated, so checking it here would
# repeat the bug that let the SSD silently fill to 100% (see header comment).
free_gib() {
  df -B1 --output=avail "${TARGET_DISK}" 2>/dev/null | awk 'NR==2 {printf "%d", $1/1073741824}'
}

# Whether repo's target/ is a relocate-targets symlink resolving onto
# TARGET_DISK, vs a plain local directory. See ONLY_RELOCATED above.
is_relocated() {
  local repo="$1" resolved
  resolved="$(readlink -f "${repo}/target" 2>/dev/null)" || return 1
  [[ "${resolved}" == "${TARGET_DISK}"/* ]]
}

# Enumerate every repo-root Cargo.toml under ROOT.
# Plain repos: <root>/<org>/<repo>/Cargo.toml (exactly 3 dirs deep).
# Worktree-managed repos (the `worktree` CLI's bare+worktree layout, e.g.
# second-brain, marquee): <root>/<org>/<repo>/.bare marks the container, and
# each worktree (main, a feature branch, ...) has its own Cargo.toml, but NOT
# necessarily one directory level down -- worktree paths are whatever git
# recorded them as, so we ask git itself (`worktree list --porcelain` against
# the .bare gitdir) instead of guessing a fixed depth. This is the ground
# truth the `worktree` CLI itself relies on, so it can't drift out of sync
# with however worktrees actually get created or moved.
#
# BUG FIXED 2026-07-05: the plain -maxdepth 3 find never saw worktree repos at
# all, so second-brain and marquee (146GiB combined, ~45% of the SSD) were
# invisible to every sweep mode and grew unbounded -- this is what actually
# drained the disk to 0 bytes.
#
# The outer find stays shallow (maxdepth 3, just enough to spot each `.bare`
# container) so it never descends into target/ -> fast, no stall.
list_manifests() {
  {
    status=0
    find "${ROOT}" -mindepth 3 -maxdepth 3 -name Cargo.toml -type f -print0 || status=1
    find "${ROOT}" -mindepth 3 -maxdepth 3 -name .bare -type d -print0 \
      | {
          listed=0
          while IFS= read -r -d '' bare; do
            # git's stderr goes to the journal, and a failed listing fails the
            # whole enumeration (after the rest is listed): the orphan pass
            # treats a missing worktree as a missing live link.
            if ! wts="$(git --git-dir="${bare}" worktree list --porcelain)"; then
              echo "sweep-repos: WARN git worktree list failed for ${bare}" >&2
              listed=1; continue
            fi
            while IFS= read -r wt; do
              # `if` not `[[ ]] &&`: under set -e, a false test on the LHS of
              # `&&` makes the whole statement's exit status 1 and kills this
              # loop right there -- and every repo's OWN bare-container entry
              # (which never has a Cargo.toml) is always the first line of its
              # `worktree list` output, so this silently truncated enumeration
              # after only 2 of 18 worktree repos before it was caught 2026-07-05.
              if [[ -f "${wt}/Cargo.toml" ]]; then printf '%s\0' "${wt}/Cargo.toml"; fi
            # sed, not awk '{print $2}': a worktree path may hold spaces.
            done < <(sed -n 's/^worktree //p' <<<"${wts}")
          done
          (( listed == 0 ))
        } || status=1
    (( status == 0 ))
  } | sort -z
}

# Sweep every built repo under ROOT with a single --time window.
sweep_pass() {
  local days="$1" count=0 manifest repo
  while IFS= read -r -d '' manifest; do
    repo="$(dirname "${manifest}")"
    # Skip repos that were never built locally (no target/) to keep the log clean.
    [[ -d "${repo}/target" ]] || continue
    if (( ONLY_RELOCATED )) && ! is_relocated "${repo}"; then
      continue
    fi
    count=$((count + 1))
    echo "sweep-repos:   [${count}] --time ${days}d ${repo}" >&2
    cargo sweep "${DRY_RUN[@]}" --time "${days}" "${repo}" \
      || echo "sweep-repos: WARN sweep failed for ${repo}" >&2
  done < <(list_manifests)
}

# Cap every built repo's target/ at SIZE, unconditionally (no free-space check).
sweep_maxsize_pass() {
  local size="$1" count=0 manifest repo
  while IFS= read -r -d '' manifest; do
    repo="$(dirname "${manifest}")"
    [[ -d "${repo}/target" ]] || continue
    if (( ONLY_RELOCATED )) && ! is_relocated "${repo}"; then
      continue
    fi
    count=$((count + 1))
    echo "sweep-repos:   [${count}] --maxsize ${size} ${repo}" >&2
    cargo sweep "${DRY_RUN[@]}" --maxsize "${size}" "${repo}" \
      || echo "sweep-repos: WARN sweep failed for ${repo}" >&2
  done < <(list_manifests)
}

# How often to re-alert while stuck in the worst case below (still below floor
# after the unconditional cap -- i.e. every repo was already under
# FALLBACK_CAP, so age/size sweeping found nothing left to reclaim). A single
# one-shot toast is easy to dismiss and forget about while the disk is still
# critically low; re-firing every 15 minutes keeps it in front of the user
# until they actually act (2026-07-24: 91% full and the escalation ladder had
# nothing 20GB+ to cap, discovered only because Claude was asked to dig in --
# nothing had alerted about it).
NOTIFY_INTERVAL=900
LAST_LOW_NOTIFY=0
# The orphan pass keeps its own limiter: every floor-restored path resets
# LAST_LOW_NOTIFY to 0, which would unthrottle a repeating orphan abort.
LAST_ORPHAN_NOTIFY=0
# Advances only when a pass completes (or is configured off), so a lock-held
# skip retries next tick and each restart makes the pass due again.
LAST_ORPHAN_RUN=0

# st_dev of a path's nearest existing ancestor (DEST may not exist yet).
# Copied from relocate-targets.
dev_of() {
  local p="$1"
  while [[ ! -e "${p}" && "${p}" != "/" ]]; do p="$(dirname "${p}")"; done
  stat -c %d "${p}" 2>/dev/null || echo "?"
}

orphan_abort() {
  local why="$1" now
  echo "sweep-repos: ERROR orphan pass aborted: ${why}" >&2
  now="$(date +%s)"
  if (( now - LAST_ORPHAN_NOTIFY >= NOTIFY_INTERVAL )); then
    toast critical "sweep-repos: orphan pass aborted" "${why}"
    LAST_ORPHAN_NOTIFY="${now}"
  fi
  return 1
}

# An unmounted SSD leaves DEST as an empty dir (or nothing) on the OS disk, and
# an empty DEST would read as "no orphans" at best. Same guard as
# relocate-targets' require_dest_mounted, but it aborts the pass, not the
# script: the watch loop must keep running.
require_dest_mounted() {
  local dest_dev repo_dev
  dest_dev="$(dev_of "${DEST}")"
  repo_dev="$(dev_of "${ROOT}")"
  if [[ "${dest_dev}" == "?" || "${dest_dev}" == "${repo_dev}" ]]; then
    orphan_abort "${DEST} is on the same filesystem as ${ROOT} (dedicated drive not mounted?)"
    return 1
  fi
}

close_fds() {
  local lockfd
  for lockfd in $1; do exec {lockfd}<&-; done
}

# Why a DEST target dir is still owned, printed; fails if nothing owns it.
# Reads the caller's `live` set.
orphan_keep_reason() {
  local dest="$1" c="$2" l rel marker line mapped
  if [[ -L "${c}" ]]; then echo "a symlink"; return 0; fi
  c="$(realpath -e -- "${c}")" || { echo "unresolvable"; return 0; }
  if [[ "${c}" != "${dest}"/* ]]; then echo "outside ${dest}"; return 0; fi
  if [[ -n "${live[${c}]:-}" ]]; then echo "live"; return 0; fi
  for l in "${!live[@]}"; do
    if [[ "${l}" == "${c}"/* ]]; then echo "holds live ${l}"; return 0; fi
    if [[ "${c}" == "${l}"/* ]]; then echo "inside live ${l}"; return 0; fi
  done
  rel="${c#"${dest}"/}"; rel="${rel%/target}"
  # DEST/<name>/target is relocate-targets --repo on a repo outside ROOT.
  if [[ "${rel}" != */* ]]; then echo "unknown layout"; return 0; fi
  marker="$(dirname "${c}")/.relocate-link"
  if [[ -e "${marker}" ]]; then
    if [[ ! -r "${marker}" ]]; then echo "unreadable ${marker}"; return 0; fi
    while IFS= read -r line; do
      if [[ -L "${line}" && "$(readlink -f -- "${line}")" == "${c}" ]]; then echo "marker link ${line}"; return 0; fi
    done < "${marker}"
  fi
  # relocate-targets maps ROOT/<rel>/target to DEST/<rel>/target. An absent
  # target is owned too: its pre-link branch re-adopts this dir next run.
  if [[ -d "${ROOT}/${rel}" ]]; then
    if [[ ! -e "${ROOT}/${rel}/target" && ! -L "${ROOT}/${rel}/target" ]]; then
      echo "repo ${ROOT}/${rel} has no target yet"; return 0
    fi
    if mapped="$(readlink -f -- "${ROOT}/${rel}/target")" \
      && [[ "${mapped}" == "${c}" || "${mapped}" == "${c}"/* ]]; then
      echo "repo link ${ROOT}/${rel}/target"; return 0
    fi
  fi
  return 1
}

# The orphan pass proper, run with DEST/.relocate.lock held (see sweep_orphans).
orphan_pass() {
  local dest="$1"
  local -a manifests=() found=() cands=() orphans=() orphan_fds=() lockfiles=()
  local -A links=() live=()
  local m l r c why f lockfd fds held dangling=0 kept=0 removed=0 freed=0 i bytes p

  # Live set: every repo's target link from the enumeration the ladder uses,
  # plus an fd scan for links it cannot see (--repo mode, nested layouts).
  mapfile -d '' manifests < <(list_manifests)
  if ! wait $!; then orphan_abort "repo enumeration under ${ROOT} failed (see above)"; return 1; fi
  for m in "${manifests[@]}"; do
    l="$(dirname "${m}")/target"
    if [[ -e "${l}" || -L "${l}" ]]; then links["$(realpath -ms -- "${l}")"]=1; fi
  done
  mapfile -d '' found < <(fd -HI -0 -t l '^target$' --max-depth 6 "${ROOT}")
  if ! wait $!; then orphan_abort "fd scan of ${ROOT} for target links failed"; return 1; fi
  for l in "${found[@]}"; do links["$(realpath -ms -- "${l}")"]=1; done
  # readlink -f fails on a link whose middle component is missing. Dropped,
  # not kept as "": an empty live path would prefix-match every candidate.
  for l in "${!links[@]}"; do
    if r="$(readlink -f -- "${l}")" && [[ -n "${r}" ]]; then live["${r}"]=1; else dangling=$((dangling + 1)); fi
  done
  echo "sweep-repos: orphan pass: links=${#links[@]} live=${#live[@]} dangling=${dangling}" >&2
  if (( ${#live[@]} == 0 )); then orphan_abort "live set is empty (no target link under ${ROOT})"; return 1; fi

  # Candidates: leaf `target` dirs only. -prune stops at the first `target` on
  # every path, so one nested inside another is never listed, and a depth-1
  # DEST/target is never descended into.
  mapfile -d '' cands < <(find "${dest}" -path "${dest}/target" -prune \
    -o -type d -name target ! -path "${dest}" -prune -print0)
  if ! wait $!; then orphan_abort "find over ${dest} failed"; return 1; fi

  for c in "${cands[@]}"; do
    if why="$(orphan_keep_reason "${dest}" "${c}")"; then
      kept=$((kept + 1))
      case "${why}" in
        "unknown layout"|unresolvable|unreadable*) echo "sweep-repos: WARN ${why} ${c}; kept" >&2 ;;
      esac
      continue
    fi
    c="$(realpath -e -- "${c}")"
    # A cargo build holds its target's .cargo-lock. Each lock stays held, on a
    # read-only fd, through this candidate's rm, so a build cannot start in it
    # between the check and the delete.
    fds=""; held=1
    mapfile -d '' lockfiles < <(find "${c}" -maxdepth 3 -name .cargo-lock -print0)
    if ! wait $!; then
      echo "sweep-repos: WARN cannot list ${c}'s cargo locks; kept" >&2
      kept=$((kept + 1)); continue
    fi
    for f in "${lockfiles[@]}"; do
      if ! { exec {lockfd}<"${f}"; } 2>/dev/null; then held=0; break; fi
      fds+=" ${lockfd}"
      if ! flock -n "${lockfd}"; then held=0; break; fi
    done
    if (( ! held )); then
      close_fds "${fds}"
      echo "sweep-repos: keeping ${c}: ${f} is held by a cargo build (or unopenable)" >&2
      kept=$((kept + 1)); continue
    fi
    orphans+=("${c}"); orphan_fds+=("${fds}")
  done

  # Breaker: this many at once means discovery broke, not that leaks piled up.
  if (( ${#orphans[@]} > ORPHAN_MAX )); then
    for i in "${!orphans[@]}"; do
      echo "sweep-repos:   would-be orphan ${orphans[${i}]}" >&2
      close_fds "${orphan_fds[${i}]}"
    done
    orphan_abort "${#orphans[@]} orphans > ORPHAN_MAX=${ORPHAN_MAX}; nothing removed. If they are legit (worktrees removed at once): SWEEP_ORPHANS=1 ORPHAN_MAX=${#orphans[@]} ~/bin/sweep-repos --maxsize 1000GB"
    return 1
  fi

  for i in "${!orphans[@]}"; do
    c="${orphans[${i}]}"
    bytes="$(du -sB1 -- "${c}" | cut -f1)" || bytes=0
    echo "sweep-repos: orphan ${c} $(numfmt --to=iec "${bytes}")${DRY_RUN:+ (dry-run)}" >&2
    if (( ${#DRY_RUN[@]} > 0 )); then close_fds "${orphan_fds[${i}]}"; continue; fi
    if rm -rf -- "${c}"; then   # regenerable: cargo build output relocated from <repo>/target
      removed=$((removed + 1)); freed=$((freed + bytes))
      p="$(dirname "${c}")"
      rm -f -- "${p}/.relocate-link"   # regenerable: the removed target's own stale owner marker
      # rmdir refuses a non-empty dir, so a parent that still holds a live
      # target survives even a wrong classification.
      while [[ "${p}" == "${dest}"/* ]] && rmdir -- "${p}" 2>/dev/null; do p="$(dirname "${p}")"; done
    else
      echo "sweep-repos: WARN rm failed for orphan ${c}" >&2
    fi
    close_fds "${orphan_fds[${i}]}"
  done
  echo "sweep-repos: orphan pass: kept=${kept} removed=${removed} freed=${freed}${DRY_RUN:+ (dry-run)}" >&2
}

# Remove DEST target dirs no live link owns. Returns 1 on an abort (nothing
# removed), 0 otherwise, including a skip.
sweep_orphans() {
  if (( ! SWEEP_ORPHANS )); then
    echo "sweep-repos: orphan pass disabled (SWEEP_ORPHANS=0)" >&2
    LAST_ORPHAN_RUN="$(date +%s)"; return 0
  fi
  # Candidates come from all of DEST, so a narrower root would shrink the live
  # set without shrinking the candidates.
  if [[ "${ROOT%/}" != "${HOME}/repos" ]]; then
    echo "sweep-repos: WARN orphan pass needs the default root (${HOME}/repos), not ${ROOT}; skipped" >&2
    LAST_ORPHAN_RUN="$(date +%s)"; return 0
  fi
  require_dest_mounted || return 1
  local dest lock rc=0
  if ! dest="$(realpath -e -- "${DEST}")" || [[ ! -d "${dest}" ]]; then
    orphan_abort "${DEST} is not a directory"; return 1
  fi
  # relocate-targets holds this lock for its whole run, so a copy still in
  # flight is never read as an orphan. A dry run opens it read-only and only if
  # it exists (relocate-targets creates it before locking), so it creates
  # nothing.
  lock="${dest}/.relocate.lock"
  local opened=0
  if (( ${#DRY_RUN[@]} == 0 )); then
    if ! { exec 9>>"${lock}"; } 2>/dev/null; then orphan_abort "cannot open ${lock}"; return 1; fi
    opened=1
  elif [[ -e "${lock}" ]]; then
    if ! { exec 9<"${lock}"; } 2>/dev/null; then orphan_abort "cannot open ${lock}"; return 1; fi
    opened=1
  fi
  if (( opened )) && ! flock -n 9; then
    echo "sweep-repos: relocate-targets running, skipping orphan pass" >&2
    exec 9>&-; return 0
  fi
  orphan_pass "${dest}" || rc=$?
  exec 9>&-
  if (( rc == 0 )); then LAST_ORPHAN_RUN="$(date +%s)"; fi
  return "${rc}"
}

if [[ -n "${MAXSIZE}" ]]; then
  echo "sweep-repos: maxsize mode: root=${ROOT} cap=${MAXSIZE}${DRY_RUN:+ (dry-run)}" >&2
  orphan_rc=0
  sweep_orphans || orphan_rc=1
  sweep_maxsize_pass "${MAXSIZE}"
  echo "sweep-repos: done" >&2
  exit "${orphan_rc}"
fi

# One watermark check: the orphan pass, then age-based tiers (gentlest), then an unconditional
# per-repo cap as the last resort. Returns 0 once the floor is restored (or
# was never breached), 1 if still below floor after every tier.
run_watermark() {
  local free
  free="$(free_gib)"
  echo "sweep-repos: watermark: ${free}GiB free on ${TARGET_DISK}, floor=${ENSURE_FREE}GiB, root=${ROOT}${DRY_RUN:+ (dry-run)}" >&2
  # The orphan pass goes first below the floor: the tiers' early return would
  # never reach it. Watch mode also runs it once per ORPHAN_INTERVAL, or a leak
  # would sit on a roomy disk forever (and keep blocking that repo's relocate).
  local overdue=0
  if [[ -n "${WATCH}" ]] && (( $(date +%s) - LAST_ORPHAN_RUN >= ORPHAN_INTERVAL )); then overdue=1; fi
  if (( free < ENSURE_FREE || overdue )); then
    local before="${free}"
    sweep_orphans || true
    free="$(free_gib)"
    if (( before < ENSURE_FREE && free >= ENSURE_FREE )); then
      echo "sweep-repos: floor restored: ${free}GiB >= ${ENSURE_FREE}GiB after the orphan pass; done" >&2
      LAST_LOW_NOTIFY=0
      return 0
    fi
  fi
  if (( free >= ENSURE_FREE )); then
    echo "sweep-repos: ${free}GiB >= ${ENSURE_FREE}GiB floor; nothing to do" >&2
    LAST_LOW_NOTIFY=0
    return 0
  fi
  for tier in "${TIERS[@]}"; do
    echo "sweep-repos: ${free}GiB < ${ENSURE_FREE}GiB floor; sweeping artifacts older than ${tier}d" >&2
    sweep_pass "${tier}"
    if [[ ${#DRY_RUN[@]} -gt 0 ]]; then
      echo "sweep-repos: (dry-run) no space reclaimed; a real run would stop at the first tier that crosses the floor" >&2
      continue
    fi
    free="$(free_gib)"
    if (( free >= ENSURE_FREE )); then
      echo "sweep-repos: floor restored: ${free}GiB >= ${ENSURE_FREE}GiB after ${tier}d tier; done" >&2
      LAST_LOW_NOTIFY=0
      return 0
    fi
  done
  echo "sweep-repos: ${free}GiB < ${ENSURE_FREE}GiB after the 1d tier; age doesn't matter anymore, capping every repo's target/ at ${FALLBACK_CAP}" >&2
  sweep_maxsize_pass "${FALLBACK_CAP}"
  if [[ ${#DRY_RUN[@]} -gt 0 ]]; then
    echo "sweep-repos: (dry-run) done" >&2
    return 0
  fi
  free="$(free_gib)"
  if (( free >= ENSURE_FREE )); then
    echo "sweep-repos: floor restored: ${free}GiB >= ${ENSURE_FREE}GiB after ${FALLBACK_CAP} cap; done" >&2
    LAST_LOW_NOTIFY=0
    return 0
  fi
  echo "sweep-repos: WARN still below floor (${free}GiB < ${ENSURE_FREE}GiB) on ${TARGET_DISK} after capping every repo at ${FALLBACK_CAP} -- no repo was even over the cap, so age/size sweeping found nothing left to reclaim" >&2
  local now
  now="$(date +%s)"
  if (( now - LAST_LOW_NOTIFY >= NOTIFY_INTERVAL )); then
    toast critical "sweep-repos: disk still low" "${TARGET_DISK} still has only ${free}GiB free (floor ${ENSURE_FREE}GiB) and no repo was over ${FALLBACK_CAP}, so the escalation ladder found nothing left to cap. Needs a bigger disk, or prune worktrees/repos you're done with. (will keep alerting every $((NOTIFY_INTERVAL / 60))m until resolved)"
    LAST_LOW_NOTIFY="${now}"
  fi
  return 1
}

if [[ -n "${ENSURE_FREE}" ]]; then
  [[ "${ENSURE_FREE}" =~ ^[0-9]+$ ]] || { echo "sweep-repos: --ensure-free must be a positive integer (GiB)" >&2; exit 2; }
  ONLY_RELOCATED=1

  if [[ -n "${WATCH}" ]]; then
    [[ "${WATCH}" =~ ^[0-9]+$ ]] || { echo "sweep-repos: --watch must be a positive integer (seconds)" >&2; exit 2; }
    echo "sweep-repos: watch mode: checking every ${WATCH}s, floor=${ENSURE_FREE}GiB on ${TARGET_DISK}" >&2
    while true; do
      run_watermark || true
      sleep "${WATCH}"
    done
  fi

  run_watermark
  exit 0
fi

# Manual single-pass mode.
echo "sweep-repos: root=${ROOT} time=${DAYS}d${DRY_RUN:+ (dry-run)}" >&2
sweep_pass "${DAYS}"
echo "sweep-repos: done" >&2
