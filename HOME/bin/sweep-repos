#!/usr/bin/env bash
# sweep-repos: reclaim Rust build artifacts across a root (default ~/repos) by
# running cargo-sweep per repo, enumerating repo-root Cargo.toml files instead
# of `cargo sweep -r <root>` -- which stalls walking into target/ and any large
# non-Rust subtrees. `find -maxdepth 3` reads only <root>/<org>/<repo> dir
# listings and never descends into target/ (depth 4+), so it is fast.
#
# Four modes:
#   manual    sweep-repos [--time DAYS]            one pass, remove artifacts
#                                                  older than DAYS (default 14)
#   watermark sweep-repos --ensure-free GIB        free-space driven: only acts
#                                                  when free space on the
#                                                  target-disk filesystem (where
#                                                  relocate-targets puts each
#                                                  repo's target/, default the
#                                                  dedicated SSD -- NOT ~/repos'
#                                                  filesystem) is below GIB, then
#                                                  sweeps in escalating tiers
#                                                  (gentlest first) until the
#                                                  floor is restored, falling
#                                                  back to an unconditional
#                                                  per-repo cap if age-based
#                                                  sweeping alone isn't enough.
#   watch     sweep-repos --ensure-free GIB --watch SECS
#                                                  same as watermark mode, but
#                                                  loops forever, checking every
#                                                  SECS. This is the reactive
#                                                  mode: meant to run as a
#                                                  long-lived systemd --user
#                                                  service instead of a cron,
#                                                  so a sudden build spike gets
#                                                  caught within seconds
#                                                  instead of waiting for the
#                                                  next scheduled tick.
#   maxsize   sweep-repos --maxsize SIZE            unconditional one-shot pass,
#                                                  caps every repo's target/ at
#                                                  SIZE (e.g. 5GB) by trimming
#                                                  its oldest artifacts.
#
# BUG FIXED 2026-07-04: watermark mode used to check free space on ROOT's
# filesystem (~/repos, which lives on /). relocate-targets moved every repo's
# target/ onto a dedicated SSD via symlink, so / always had plenty of room and
# the watermark never tripped -- it logged "nothing to do" every day while the
# SSD silently filled to 100%. Fixed by checking TARGET_DISK instead.
#
# BUG FIXED 2026-07-05: --time-based tiers (even the harshest, 1d) can't touch
# repos rebuilt daily -- measured 4.4GiB reclaimed vs. ~205GiB reclaimed by
# --maxsize across the same repos, because active repos keep refreshing
# mtimes on old artifacts through incremental builds. A separate weekly
# --maxsize cron used to paper over this, but that only ran once a week while
# hot repos (second-brain, marquee) regrew 70GiB+ in the gap. Folded --maxsize
# into watermark mode itself as the last-resort tier: if the age-based ladder
# doesn't restore the floor, cap every repo unconditionally before giving up.
# This is what makes watch mode a real reactive fix instead of a faster-ticking
# version of the same incomplete remediation.
#
# REACTIVE, NOT CALENDAR-DRIVEN (2026-07-05): a fixed cron schedule (daily,
# weekly) always has a gap where the disk can silently fill between ticks --
# that gap is what caused two separate 0-byte incidents in one day. `--watch`
# replaces the daily/weekly crons with one continuously-running check: cheap
# when healthy (a single `df` call), and reacts within one poll interval the
# moment free space actually drops, instead of waiting for the next scheduled
# run. Installed as the sweep-repos-watchdog systemd --user service.
#
# Managed by scottidler/dotfiles via manifest (link: HOME -> $HOME). Edit the
# repo copy, not the ~/bin symlink. The service is the `sweep-repos-watchdog`
# entry in manifest.yml's script: section.
set -euo pipefail

# cron runs with a minimal PATH (/usr/bin:/bin) that omits ~/.cargo/bin, so the
# `command -v cargo-sweep` check below would fail and the script would exit
# without sweeping -- the exact silent failure that let / fill to 96%. Put
# cargo's bin dir on PATH ourselves so this behaves identically under cron and
# an interactive login shell.
export PATH="${HOME}/.cargo/bin:${PATH}"

DAYS=14
ROOT="${HOME}/repos"
TARGET_DISK="/media/saidler/intel-480gb-ssd"
ENSURE_FREE=""
MAXSIZE=""
WATCH=""
DRY_RUN=()

# Escalation ladder for watermark mode: gentlest (most days = fewest artifacts
# removed) first, harshest last. Only descend a tier if the floor isn't yet met.
TIERS=(14 7 3 1)

# Last-resort cap used inside watermark/watch mode once the age-based ladder
# above is exhausted and the floor still isn't restored -- age stops mattering
# at that point, every repo's target/ (even one rebuilt seconds ago) gets
# capped. Same value the old standalone weekly maxsize cron used.
FALLBACK_CAP="5GB"

usage() {
  cat >&2 <<'EOF'
usage: sweep-repos [--time DAYS | --ensure-free GIB [--watch SECS] | --maxsize SIZE] [--root DIR] [--target-disk DIR] [--dry-run]
  --time DAYS        manual mode: remove build artifacts older than DAYS (default: 14)
  --ensure-free GIB  watermark mode: sweep only when free space on the
                     target-disk filesystem is below GIB, escalating
                     14d -> 7d -> 3d -> 1d, then an unconditional
                     ${FALLBACK_CAP} per-repo cap, until the floor is restored
                     (overrides --time)
  --watch SECS       with --ensure-free: don't exit after one check -- loop
                     forever, re-checking every SECS. Meant to run as a
                     long-lived service (see sweep-repos-watchdog.service)
                     instead of a cron, so a sudden build spike is caught
                     within one poll interval instead of the next scheduled tick.
  --maxsize SIZE     one-shot mode: unconditionally cap every repo's target/ at
                     SIZE (e.g. 5GB), trimming oldest artifacts (overrides
                     --time and --ensure-free)
  --root DIR         search root to enumerate repos under (default: ~/repos)
  --target-disk DIR  filesystem to check free space on -- must match where
                     relocate-targets sends target/ dirs
                     (default: /media/saidler/intel-480gb-ssd)
  --dry-run          report only; delete nothing
Enumerates <root>/<org>/<repo>/Cargo.toml (and, for worktree-managed repos,
<root>/<org>/<repo>/<worktree>/Cargo.toml) and runs cargo-sweep per repo.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --time)        DAYS="$2"; shift 2 ;;
    --ensure-free) ENSURE_FREE="$2"; shift 2 ;;
    --maxsize)     MAXSIZE="$2"; shift 2 ;;
    --watch)       WATCH="$2"; shift 2 ;;
    --root)        ROOT="$2"; shift 2 ;;
    --target-disk) TARGET_DISK="$2"; shift 2 ;;
    --dry-run)     DRY_RUN=(--dry-run); shift ;;
    -h|--help)     usage; exit 0 ;;
    *) echo "sweep-repos: unknown arg: $1" >&2; usage; exit 2 ;;
  esac
done

if [[ -n "${WATCH}" && -z "${ENSURE_FREE}" ]]; then
  echo "sweep-repos: --watch requires --ensure-free" >&2
  exit 2
fi

# Best-effort desktop toast. Works from cron by pointing at the user's session
# bus (cron has no DBUS_SESSION_BUS_ADDRESS). Never fails the script.
toast() {
  command -v notify-send >/dev/null 2>&1 || return 0
  local urgency="$1"; shift
  DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}" \
    notify-send -a sweep-repos -u "${urgency}" "$@" >/dev/null 2>&1 || true
}

# A missing cargo-sweep is the exact silent failure that let / fill to 100%:
# the cron logged "not installed" to a file nobody reads and swept nothing.
# Complain loudly so it can't rot unnoticed.
if ! command -v cargo-sweep >/dev/null 2>&1; then
  echo "sweep-repos: cargo-sweep not installed" >&2
  toast critical "sweep-repos: cargo-sweep MISSING" "Rust build artifacts are NOT being swept and the disk will fill. Install it: cargo install cargo-sweep"
  exit 1
fi

# Available GiB on TARGET_DISK -- where relocate-targets actually puts each
# repo's target/ dir. This is deliberately NOT ROOT's filesystem: ROOT (~/repos)
# stays roomy forever once targets are relocated, so checking it here would
# repeat the bug that let the SSD silently fill to 100% (see header comment).
free_gib() {
  df -B1 --output=avail "${TARGET_DISK}" 2>/dev/null | awk 'NR==2 {printf "%d", $1/1073741824}'
}

# Enumerate every repo-root Cargo.toml under ROOT.
# Plain repos: <root>/<org>/<repo>/Cargo.toml (exactly 3 dirs deep).
# Worktree-managed repos (the `worktree` CLI's bare+worktree layout, e.g.
# second-brain, marquee): <root>/<org>/<repo>/.bare marks the container, and
# each worktree (main, a feature branch, ...) has its own Cargo.toml, but NOT
# necessarily one directory level down -- worktree paths are whatever git
# recorded them as, so we ask git itself (`worktree list --porcelain` against
# the .bare gitdir) instead of guessing a fixed depth. This is the ground
# truth the `worktree` CLI itself relies on, so it can't drift out of sync
# with however worktrees actually get created or moved.
#
# BUG FIXED 2026-07-05: the plain -maxdepth 3 find never saw worktree repos at
# all, so second-brain and marquee (146GiB combined, ~45% of the SSD) were
# invisible to every sweep mode and grew unbounded -- this is what actually
# drained the disk to 0 bytes.
#
# The outer find stays shallow (maxdepth 3, just enough to spot each `.bare`
# container) so it never descends into target/ -> fast, no stall.
list_manifests() {
  {
    find "${ROOT}" -mindepth 3 -maxdepth 3 -name Cargo.toml -type f -print0
    find "${ROOT}" -mindepth 3 -maxdepth 3 -name .bare -type d -print0 \
      | while IFS= read -r -d '' bare; do
          git --git-dir="${bare}" worktree list --porcelain 2>/dev/null \
            | awk '/^worktree /{print $2}' \
            | while IFS= read -r wt; do
                # `if` not `[[ ]] &&`: under set -e, a false test on the LHS of
                # `&&` makes the whole statement's exit status 1 and kills this
                # loop right there -- and every repo's OWN bare-container entry
                # (which never has a Cargo.toml) is always the first line of its
                # `worktree list` output, so this silently truncated enumeration
                # after only 2 of 18 worktree repos before it was caught 2026-07-05.
                if [[ -f "${wt}/Cargo.toml" ]]; then printf '%s\0' "${wt}/Cargo.toml"; fi
              done
        done
  } | sort -z
}

# Sweep every built repo under ROOT with a single --time window.
sweep_pass() {
  local days="$1" count=0 manifest repo
  while IFS= read -r -d '' manifest; do
    repo="$(dirname "${manifest}")"
    # Skip repos that were never built locally (no target/) to keep the log clean.
    [[ -d "${repo}/target" ]] || continue
    count=$((count + 1))
    echo "sweep-repos:   [${count}] --time ${days}d ${repo}" >&2
    cargo sweep "${DRY_RUN[@]}" --time "${days}" "${repo}" \
      || echo "sweep-repos: WARN sweep failed for ${repo}" >&2
  done < <(list_manifests)
}

# Cap every built repo's target/ at SIZE, unconditionally (no free-space check).
sweep_maxsize_pass() {
  local size="$1" count=0 manifest repo
  while IFS= read -r -d '' manifest; do
    repo="$(dirname "${manifest}")"
    [[ -d "${repo}/target" ]] || continue
    count=$((count + 1))
    echo "sweep-repos:   [${count}] --maxsize ${size} ${repo}" >&2
    cargo sweep "${DRY_RUN[@]}" --maxsize "${size}" "${repo}" \
      || echo "sweep-repos: WARN sweep failed for ${repo}" >&2
  done < <(list_manifests)
}

if [[ -n "${MAXSIZE}" ]]; then
  echo "sweep-repos: maxsize mode: root=${ROOT} cap=${MAXSIZE}${DRY_RUN:+ (dry-run)}" >&2
  sweep_maxsize_pass "${MAXSIZE}"
  echo "sweep-repos: done" >&2
  exit 0
fi

# Set once a "still low" toast has fired, so --watch mode (checking every few
# seconds) sends ONE notification per low-disk episode instead of re-spamming
# it every poll interval for as long as the disk stays below floor. Reset the
# moment the floor is restored, so a later, distinct episode still alerts.
LOW_NOTIFIED=0

# One watermark check: age-based tiers first (gentlest), then an unconditional
# per-repo cap as the last resort. Returns 0 once the floor is restored (or
# was never breached), 1 if still below floor after every tier.
run_watermark() {
  local free
  free="$(free_gib)"
  echo "sweep-repos: watermark: ${free}GiB free on ${TARGET_DISK}, floor=${ENSURE_FREE}GiB, root=${ROOT}${DRY_RUN:+ (dry-run)}" >&2
  if (( free >= ENSURE_FREE )); then
    echo "sweep-repos: ${free}GiB >= ${ENSURE_FREE}GiB floor; nothing to do" >&2
    LOW_NOTIFIED=0
    return 0
  fi
  for tier in "${TIERS[@]}"; do
    echo "sweep-repos: ${free}GiB < ${ENSURE_FREE}GiB floor; sweeping artifacts older than ${tier}d" >&2
    sweep_pass "${tier}"
    if [[ ${#DRY_RUN[@]} -gt 0 ]]; then
      echo "sweep-repos: (dry-run) no space reclaimed; a real run would stop at the first tier that crosses the floor" >&2
      continue
    fi
    free="$(free_gib)"
    if (( free >= ENSURE_FREE )); then
      echo "sweep-repos: floor restored: ${free}GiB >= ${ENSURE_FREE}GiB after ${tier}d tier; done" >&2
      LOW_NOTIFIED=0
      return 0
    fi
  done
  echo "sweep-repos: ${free}GiB < ${ENSURE_FREE}GiB after the 1d tier; age doesn't matter anymore, capping every repo's target/ at ${FALLBACK_CAP}" >&2
  sweep_maxsize_pass "${FALLBACK_CAP}"
  if [[ ${#DRY_RUN[@]} -gt 0 ]]; then
    echo "sweep-repos: (dry-run) done" >&2
    return 0
  fi
  free="$(free_gib)"
  if (( free >= ENSURE_FREE )); then
    echo "sweep-repos: floor restored: ${free}GiB >= ${ENSURE_FREE}GiB after ${FALLBACK_CAP} cap; done" >&2
    LOW_NOTIFIED=0
    return 0
  fi
  echo "sweep-repos: WARN still below floor (${free}GiB < ${ENSURE_FREE}GiB) on ${TARGET_DISK} after capping every repo at ${FALLBACK_CAP} -- the disk is genuinely too small for the current checked-out footprint" >&2
  if (( ! LOW_NOTIFIED )); then
    toast critical "sweep-repos: disk still low" "Capped every repo at ${FALLBACK_CAP} and ${TARGET_DISK} still has only ${free}GiB free (floor ${ENSURE_FREE}GiB). Needs a bigger disk, or prune worktrees you're done with."
    LOW_NOTIFIED=1
  fi
  return 1
}

if [[ -n "${ENSURE_FREE}" ]]; then
  [[ "${ENSURE_FREE}" =~ ^[0-9]+$ ]] || { echo "sweep-repos: --ensure-free must be a positive integer (GiB)" >&2; exit 2; }

  if [[ -n "${WATCH}" ]]; then
    [[ "${WATCH}" =~ ^[0-9]+$ ]] || { echo "sweep-repos: --watch must be a positive integer (seconds)" >&2; exit 2; }
    echo "sweep-repos: watch mode: checking every ${WATCH}s, floor=${ENSURE_FREE}GiB on ${TARGET_DISK}" >&2
    while true; do
      run_watermark || true
      sleep "${WATCH}"
    done
  fi

  run_watermark
  exit 0
fi

# Manual single-pass mode.
echo "sweep-repos: root=${ROOT} time=${DAYS}d${DRY_RUN:+ (dry-run)}" >&2
sweep_pass "${DAYS}"
echo "sweep-repos: done" >&2
