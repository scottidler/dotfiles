#!/usr/bin/env bash
# remind: spoken reminders that land in Obsidian and carry forward in the
# daily note until checked off or deleted.
#
# usage:
#   remind          toggle: first press starts recording, second press stops,
#                     transcribes (dictate), cleans up the wording (Groq chat),
#                     and appends "- [ ] <text>" to the reminders note
#   remind add TEXT append TEXT without recording
#   remind list     print open reminders
#
# The daily note template lists every open reminder (Dataview), so an open
# reminder shows up in each day's note until it is closed.
# env: REMIND_FILE  (default: vault notes/reminders.md)
#      REMIND_MODEL (Groq chat model for cleanup, default: qwen/qwen3.8-27b)
set -euo pipefail

# GNOME shortcuts run with a bare PATH: no ~/bin (dictate), ~/.cargo/bin (manifest), or mise (jq).
PATH="$HOME/bin:$HOME/.cargo/bin:$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

VAULT="$HOME/repos/scottidler/obsidian"
FILE="${REMIND_FILE:-$VAULT/notes/reminders.md}"
MODEL="${REMIND_MODEL:-qwen/qwen3.8-27b}"
STATE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/remind"
FIFO="$STATE/stop"
PIDFILE="$STATE/pid"
LOG="$HOME/.local/share/remind/remind.log"

mkdir -p "$STATE" "$(dirname "$LOG")"

log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG"; }
# One notification slot, replaced in place, so a burst of presses never stacks toasts.
note() {
    local id
    id="$(cat "$STATE/note-id" 2>/dev/null || echo 0)"
    notify-send -a Reminders -p -r "$id" "$@" > "$STATE/note-id.tmp" && mv "$STATE/note-id.tmp" "$STATE/note-id"
}
die() { log "ERROR: $*"; note -u critical "Reminder failed" "$*"; echo "remind: $*" >&2; exit 1; }

load_groq_key() {
    [[ -n "${GROQ_API_KEY:-}" ]] && return
    # GNOME shortcuts do not inherit the login shell's secrets.
    local line
    line="$(manifest age decrypt "$HOME/repos/scottidler/keep/.env/groq-api-key.age")" \
        || die "could not decrypt groq-api-key.age"
    # The file holds a full `export GROQ_API_KEY=...` line, not the bare key.
    line="${line#export }"; line="${line#GROQ_API_KEY=}"; line="${line//\"/}"; line="${line//\'/}"
    GROQ_API_KEY="$line"
    export GROQ_API_KEY
}

ensure_file() {
    [[ -f "$FILE" ]] && return
    cat > "$FILE" <<'EOF'
---
title: reminders
type: reminders
origin: authored
tags: [reminders]
---

# reminders

Open items show in every daily note until checked off or deleted.

EOF
}

append() {
    local text="$1"
    [[ -n "${text//[[:space:]]/}" ]] || die "empty reminder, nothing saved"
    ensure_file
    printf -- '- [ ] %s (added %s)\n' "$text" "$(date '+%F %H:%M')" >> "$FILE"
    log "added: $text"
    note "Reminder saved" "$text"
}

cleanup_text() {
    local raw="$1" today body out
    today="$(date '+%A %F')"
    body="$(jq -n --arg m "$MODEL" --arg t "$raw" --arg d "$today" '{
        model: $m, temperature: 0,
        messages: [
          {role: "system", content: ("Today is " + $d + ". Rewrite the dictated reminder as one short imperative sentence. Apply the speaker'"'"'s self-corrections (\"no, I mean X\" means X), drop filler and false starts, keep every name and time. Turn relative dates (tomorrow, Friday, next week) into absolute dates like \"Mon 2026-11-16\". If the text is unclear or not a reminder, output it unchanged. Never refuse, explain, or add commentary. Output only the sentence.")},
          {role: "user", content: $t}
        ]}')"
    out="$(curl -fsS https://api.groq.com/openai/v1/chat/completions \
        -H "Authorization: Bearer $GROQ_API_KEY" -H 'Content-Type: application/json' \
        -d "$body" | jq -r '.choices[0].message.content // empty')" || out=""
    if [[ -z "$out" ]]; then
        log "cleanup failed, keeping raw transcript"
        printf '%s' "$raw"
    else
        printf '%s' "$out"
    fi
}

start_recording() {
    load_groq_key
    rm -f "$FIFO"; mkfifo "$FIFO"
    (
        # Read-write open never blocks on a fifo; dictate's `read` waits for the stop press.
        raw="$(dictate <> "$FIFO" 2>>"$LOG")" || { rm -f "$PIDFILE" "$FIFO"; die "dictate failed (see $LOG)"; }
        rm -f "$PIDFILE" "$FIFO"
        log "raw: $raw"
        # Whisper turns silence into "Thank you." or "."; never save those.
        local words
        words="$(tr -cs '[:alpha:]' ' ' <<<"$raw" | wc -w)"
        if (( words < 2 )) || grep -qiE '^[[:space:]]*(thank you|thanks for watching)[.!]?[[:space:]]*$' <<<"$raw"; then
            log "nothing heard, not saved: $raw"
            note "Nothing heard" "No reminder saved."
            exit 0
        fi
        append "$(cleanup_text "$raw")"
    ) &
    echo $! > "$PIDFILE"
    note "Recording reminder" "Tap again, or release if holding, to stop."
}

ms() { date +%s%3N; }
recording() { [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }
stop_recording() { [[ -p "$FIFO" ]] && echo > "$FIFO"; }

# Tap = toggle, hold = record until release. GNOME fires the shortcut again on
# every key repeat (500 ms delay, then every 30 ms), so a hold shows up as a
# burst of presses and the release as the burst stopping.
press() {
    exec 9>"$STATE/lock"
    flock 9
    local now prev start
    now="$(ms)"
    prev="$(cat "$STATE/last" 2>/dev/null || echo 0)"
    echo "$now" > "$STATE/last"
    if recording; then
        start="$(cat "$STATE/start")"
        if [[ "$(cat "$STATE/mode")" == toggle ]] && (( now - start > 700 )); then
            stop_recording
        fi
        return
    fi
    (( now - prev < 250 )) && return   # repeat of a key still held after a stop
    echo "$now" > "$STATE/start"
    echo pending > "$STATE/mode"
    start_recording
    flock -u 9
    (
        sleep 0.7
        if (( $(cat "$STATE/last") - $(cat "$STATE/start") > 400 )); then
            echo hold > "$STATE/mode"
            while (( $(ms) - $(cat "$STATE/last") < 250 )); do sleep 0.05; done
            stop_recording
        else
            echo toggle > "$STATE/mode"
        fi
    ) 9>&- &
}

case "${1:-}" in
    "") press ;;
    add) shift; [[ $# -gt 0 ]] || die "usage: remind add TEXT"; append "$*" ;;
    list) [[ -f "$FILE" ]] && grep -E '^\s*- \[ \] ' "$FILE" || true ;;
    -h|--help) awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next}{exit}' "$0" ;;
    *) die "unknown command: $1 (see remind --help)" ;;
esac
