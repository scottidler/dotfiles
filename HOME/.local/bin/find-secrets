#!/usr/bin/env bash
# find-secrets: Identify paths to secret/credential files (NOT their contents)

set -euo pipefail

echo "=== Secret File Discovery Report ==="
echo "Generated: $(date)"
echo ""

# Common config directories to search
CONFIG_DIRS=(
    "$HOME/.config"
    "$HOME/.ssh"
    "$HOME/.gnupg"
    "$HOME/.aws"
    "$HOME/.kube"
    "$HOME/.docker"
)

# Patterns that suggest secret/credential files
SECRET_PATTERNS=(
    "*key*"
    "*token*"
    "*secret*"
    "*credential*"
    "*api*"
    "*auth*"
    "*password*"
    "*pat*"
    "*.env"
    "*oauth*"
)

# Specific known secret file names
KNOWN_SECRET_FILES=(
    "credentials"
    "config"
    "id_rsa"
    "id_ed25519"
    "known_hosts"
)

echo "=== 1. Files matching secret patterns in config dirs ==="
for dir in "${CONFIG_DIRS[@]}"; do
    if [[ -d "$dir" ]]; then
        echo ""
        echo "[$dir]"
        for pattern in "${SECRET_PATTERNS[@]}"; do
            find "$dir" -maxdepth 3 -type f -iname "$pattern" 2>/dev/null | while read -r f; do
                size=$(stat -c%s "$f" 2>/dev/null || echo "?")
                echo "  $f ($size bytes)"
            done
        done | sort -u
    fi
done

echo ""
echo "=== 2. Specific config subdirectories with likely secrets ==="
SPECIFIC_DIRS=(
    "$HOME/.config/github"
    "$HOME/.config/atlassian"
    "$HOME/.config/openai"
    "$HOME/.config/anthropic"
    "$HOME/.config/gh"
    "$HOME/.config/gcloud"
    "$HOME/.config/azure"
    "$HOME/.config/1password"
)

for dir in "${SPECIFIC_DIRS[@]}"; do
    if [[ -d "$dir" ]]; then
        echo ""
        echo "[$dir] EXISTS"
        find "$dir" -type f 2>/dev/null | while read -r f; do
            size=$(stat -c%s "$f" 2>/dev/null || echo "?")
            echo "  $f ($size bytes)"
        done
    fi
done

echo ""
echo "=== 3. References in shell export files ==="
SHELL_EXPORT_DIRS=(
    "$HOME/.shell-exports.d"
    "$HOME/.shell-env.d"
)

for dir in "${SHELL_EXPORT_DIRS[@]}"; do
    if [[ -d "$dir" ]]; then
        echo ""
        echo "[$dir]"
        for f in "$dir"/*; do
            [[ -f "$f" ]] || continue
            echo "  File: $f"
            # Find lines that cat/source files into env vars (show pattern, not value)
            grep -oE '\$\(cat [^)]+\)|\bcat [^ ]+|source [^ ]+|\. [^ ]+' "$f" 2>/dev/null | while read -r ref; do
                echo "    -> references: $ref"
            done
            # Find export statements with file paths
            grep -E '^export [A-Z_]+.*/' "$f" 2>/dev/null | sed 's/=.*/=<REDACTED>/' | while read -r line; do
                echo "    -> $line"
            done
        done
    fi
done

echo ""
echo "=== 4. Environment variables suggesting secrets (names only) ==="
env | grep -iE 'key|token|secret|api|auth|password|credential' | cut -d= -f1 | sort -u | while read -r var; do
    echo "  \$$var is set"
done

echo ""
echo "=== 5. Summary of likely secret locations ==="
echo "Searching for files that may contain credentials..."

# Quick scan for common credential file extensions/names
find "$HOME/.config" -maxdepth 4 -type f \( \
    -name "*.key" -o \
    -name "*.pem" -o \
    -name "*.crt" -o \
    -name "*.env" -o \
    -name "token" -o \
    -name "credentials" -o \
    -name "secrets" -o \
    -name "auth.json" -o \
    -name "config.json" -o \
    -name "settings.json" \
\) 2>/dev/null | while read -r f; do
    echo "  $f"
done

echo ""
echo "=== Done ==="
