#!/usr/bin/env python3
"""Keep Firefox audio streams at 100% volume.

Firefox on Linux (snap + PipeWire) sets its own stream volume to a low value
on every new audio stream creation. This daemon detects that and resets it.
"""
import json
import logging
import subprocess
import time

logging.basicConfig(
    format='%(asctime)s %(message)s',
    datefmt='%Y-%m-%d %H:%M:%S',
    level=logging.INFO,
)

def get_low_firefox_streams():
    result = subprocess.run(['pw-dump'], capture_output=True, text=True)
    try:
        data = json.loads(result.stdout)
    except Exception:
        return []

    low_streams = []
    for node in data:
        if 'Node' not in node.get('type', ''):
            continue
        info = node.get('info', {})
        props = info.get('props', {})
        if props.get('application.name') != 'Firefox':
            continue
        if props.get('media.class') != 'Stream/Output/Audio':
            continue
        for p in (info.get('params', {}).get('Props') or []):
            vols = p.get('channelVolumes', [])
            if vols and any(v < 0.95 for v in vols):
                low_streams.append((node.get('id'), vols, props.get('media.name', '')))
                break
    return low_streams

while True:
    for stream_id, vols, media_name in get_low_firefox_streams():
        pct = round(vols[0] ** (1/3) * 100)
        label = f'"{media_name}"' if media_name else f'stream {stream_id}'
        logging.info(f'reset {label} from ~{pct}% to 100%')
        subprocess.run(['wpctl', 'set-volume', str(stream_id), '1.0'],
                       capture_output=True)
    time.sleep(0.3)
