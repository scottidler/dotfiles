#!/bin/sh
# rustup shell setup
# affix colons on either side of $PATH to simplify matching
case ":${PATH}:" in
*:"$HOME/.cargo/bin":*) ;;
*)
    # Prepending path in case a system-installed rustc needs to be overridden
    path+=( "$HOME/.cargo/bin" )
	;;
esac

# RUSTC_WRAPPER/sccache now live in .zshenv so non-interactive shells (otto ci,
# agent-invoked cargo builds) get the compiler cache too.

# cargo-mutants scratch copies each build their own real target/ (the target symlink
# does not follow a copy). On /var/tmp (root NVMe) 8 copies wrote 63 GB and stalled
# the desktop for 10 minutes (2026-10-19). Only hosts with the samsung drive set it.
if [ -d /media/saidler/4tb ]; then
  export TMPDIR_MUTANTS=/media/saidler/4tb/mutants-tmp
fi
