# vim: filetype=sh

# node's fetch() resolves DNS itself and ignores HTTP_PROXY, so every node CLI
# dies with EAI_AGAIN inside Claude Code's sandbox while curl works fine.
# Opt fetch into the proxy env that is already set there. Needs node >= 24;
# inert elsewhere, since no proxy is set outside the sandbox.
export NODE_USE_ENV_PROXY=1
