ServerAliveInterval 55

Host desk.lan
    HostName desk.lan

# Travel-mode X11: jump through Tailscale SSH, then hop to real OpenSSH on
# desk's loopback. Tailscale SSH itself doesn't implement X11 forwarding
# (tailscale/tailscale#5160), so the inner OpenSSH connection is what carries
# the X11 channel. ACL-gating still applies on the jump.
Host desk.ts
    HostName 127.0.0.1
    ProxyJump saidler@desk.taild2b9be.ts.net
    User saidler
    IdentityFile ~/.ssh/identities/home/id_ed25519
    ForwardX11 yes
    ForwardX11Trusted yes

# Home key is the default for plain `ssh git@github.com`, but NOT under
# ~/.gitconfig-ssh (it exports GITCONFIG_SSH_KEY and passes the persona key with
# -i). A default IdentityFile stacks with that -i, and when both keys are in the
# agent ssh offers them in AGENT order, not -i order, so a fresh agent that
# loaded the home key first pushed tatari-tv as scottidler (2026-09-23).
Match host github.com exec "test -z $GITCONFIG_SSH_KEY"
    IdentityFile ~/.ssh/identities/home/id_ed25519

Host github.com
    HostName github.com
    PreferredAuthentications publickey
    IdentitiesOnly yes
    User git

Host nas.lan
    IdentityFile ~/.ssh/identities/home/id_ed25519
    ForwardAgent no
    ForwardX11 no
    ForwardX11Trusted no
    User saidler

# mini.lan runs macOS with no X server (no XQuartz), so it can't honor the
# *.lan ForwardX11 default - opt out here to avoid "X11 forwarding request
# failed on channel 0" on every login. ssh is first-match-wins, so this block
# must precede *.lan; ForwardAgent/User/IdentityFile still inherit from it.
Host mini.lan
    ForwardX11 no
    ForwardX11Trusted no

Host *.lan *.wan *.localdomain
    IdentityFile ~/.ssh/identities/home/id_ed25519
    ForwardAgent yes
    ForwardX11 yes
    ForwardX11Trusted yes
    User saidler

Host nixos
    IdentityFile ~/.ssh/identities/home/id_ed25519
    ForwardAgent yes
    ForwardX11 yes
    User saidler
