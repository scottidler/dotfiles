[Unit]
Description=Reactive watermark sweep of Rust build artifacts on intel-480gb-ssd

[Service]
Type=simple
Environment=SWEEP_ORPHANS=1
EnvironmentFile=-%h/.config/sweep-repos.env
ExecStart=%h/bin/sweep-repos --ensure-free 40 --watch 30
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
